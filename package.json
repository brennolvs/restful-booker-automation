{
  "name": "restful-booker-automation",
  "version": "1.0.0",
  "description": "Portfolio framework simulating a full QA automation cycle (UI + API + CI + performance) with Playwright, targeting Restful-Booker / Restful-Booker-Platform.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "report": "playwright show-report",
    "test:perf": "k6 run performance/k6/booking-smoke.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "dotenv": "^16.4.5"
  }
}
